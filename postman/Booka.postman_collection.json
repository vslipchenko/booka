					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const responseData = JSON.parse(responseBody);\r",
									"postman.setEnvironmentVariable('accessToken', responseData.data.signIn.accessToken);"
								],
								"type": "text/javascript"
							}
